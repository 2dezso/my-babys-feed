rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A device counts as a member once it has a document under households/{code}/members/{its own id}.
    function isMember(code) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/households/$(code)/members/$(request.auth.uid));
    }

    // A signed-in device can add only itself, and only with a household code of a plausible length.
    // Members can see, update and remove the list (that is how a device is removed later).
    match /households/{code}/members/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid
                    && code.size() >= 6 && code.size() <= 12;
      allow read, update, delete: if isMember(code);
    }

    // Everything else in a household (feeds, poos, profile, bottle, milestones, feedback) is members only.
    match /households/{code}/{document=**} {
      allow read, write: if isMember(code);
    }
  }
}
