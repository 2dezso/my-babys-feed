rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A device counts as a member once it has a document under households/{code}/members/{its own id}.
    function isMember(code) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/households/$(code)/members/$(request.auth.uid));
    }

    // A signed-in device can add only itself, and only with a household code of a plausible length.
    // Members can see, update and remove the list (that is how a device is removed later).
    match /households/{code}/members/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid
                    && code.size() >= 6 && code.size() <= 12;
      allow read, update, delete: if isMember(code);
    }

    // A small dated marker left when a household is deleted. Any signed-in device may read it, so a phone that still
    // holds the deleted code can be told. It holds no diary content. Members create it as the last step of a delete.
    match /households/{code}/tombstone/{doc} {
      allow read: if request.auth != null;
    }

    // What a household has paid for (if payments are ever added). Members can read it so the app can unlock things, but
    // no phone can write it: only the server, which checks Apple's receipt, writes it. Server code uses the Admin SDK,
    // which is not subject to these rules. Keeping this out of the members-only list below is what makes it read-only.
    match /households/{code}/entitlement/{doc} {
      allow read: if isMember(code);
    }

    // The diary itself (feeds, poos, profile, bottle, milestones, feedback, and the deletion marker above) is members
    // only. The collections are named, so a new one is closed to phones until it is added here on purpose.
    match /households/{code}/{coll}/{document=**} {
      allow read, write: if isMember(code)
        && coll in ['feeds', 'poos', 'profile', 'bottle', 'milestones', 'feedback', 'tombstone'];
    }
  }
}
